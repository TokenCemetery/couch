# Copy to deploy/.env and adjust. Docker Compose reads it for compose.yaml.

# Host folder with the videos, mounted read-only; it must be readable by
# UID 10001, the user Couch runs as in the container.
COUCH_MEDIA=/srv/media
# Host folder of Emby Web 4.10 containing index.html, readable by UID 10001.
COUCH_WEB=/opt/emby-webui

# More Couch options, for example -name Living-room or -rescan-interval 30m.
COUCH_ARGS=

# Online metadata; a provider is used only when its key is set.
COUCH_TMDB_API_KEY=
COUCH_TVDB_API_KEY=
# TheAudioDB for music; 123 is its free key.
COUCH_AUDIODB_API_KEY=

# VA-API on an AMD or Intel GPU: uncomment these three lines. The group ID is
# the host's render group: getent group render | cut -d: -f3
#COMPOSE_FILE=compose.yaml:compose.vaapi.yaml
#COUCH_RENDER_GID=990
#COUCH_ARGS=-hwaccel vaapi
